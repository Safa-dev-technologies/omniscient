{
  "name": "omniscient",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "workers": "tsx watch src/workers.ts",
    "dev:dashboard": "cd dashboard && pnpm dev",
    "dev:admin": "cd admin-dashboard && PORT=3002 pnpm dev",
    "dev:all": "concurrently \"pnpm dev\" \"pnpm dev:dashboard\" \"pnpm dev:admin\"",
    "build:dashboard": "cd dashboard && pnpm build",
    "build:admin": "cd admin-dashboard && pnpm build",
    "build:all": "pnpm build && pnpm build:dashboard && pnpm build:admin",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx scripts/seed.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.958.0",
    "@aws-sdk/client-secrets-manager": "^3.972.0",
    "@aws-sdk/s3-request-presigner": "^3.958.0",
    "@fastify/cors": "11",
    "@fastify/helmet": "13",
    "@fastify/multipart": "9",
    "@fastify/rate-limit": "10",
    "@fastify/static": "^9.0.0",
    "@fastify/websocket": "11",
    "@notionhq/client": "^2.2.14",
    "@pinecone-database/pinecone": "^6.1.3",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@sentry/node": "^10.35.0",
    "@types/bcrypt": "^6.0.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.66.2",
    "cheerio": "^1.1.2",
    "cron-parser": "^4.9.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "groq-sdk": "^0.37.0",
    "ioredis": "^5.8.2",
    "mammoth": "^1.11.0",
    "nanoid": "^5.1.6",
    "openai": "^6.15.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "robots-parser": "^3.0.1",
    "safe-regex": "^2.1.1",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.0.3",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.16.0",
    "@types/safe-regex": "^1.1.6",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "@vitest/coverage-v8": "^4.0.16",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.7.4",
    "prisma": "^7.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.1",
    "vitest": "^4.0.16"
  }
}
