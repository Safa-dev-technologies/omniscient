# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://omniscient:omniscient@localhost:5433/omniscient

# Redis
REDIS_URL=redis://localhost:6379

# Pinecone
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX=omniscient-knowledge

# LLM Providers
GROQ_API_KEY=your-groq-api-key
OPENAI_API_KEY=your-openai-api-key

# Embeddings
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Storage
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
# For S3/R2:
# STORAGE_PROVIDER=s3
# AWS_ACCESS_KEY_ID=xxx
# AWS_SECRET_ACCESS_KEY=xxx
# AWS_BUCKET=omniscient-files
# AWS_REGION=us-east-1

# PDF Processing (optional - falls back to pdf-parse)
LLAMAPARSE_API_KEY=

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# API
API_VERSION=v1

# Sync Scheduling (for external connector sync)
SYNC_DEFAULT_INTERVAL_HOURS=24
SYNC_MIN_INTERVAL_HOURS=1
SYNC_SCHEDULER_INTERVAL=300

# Master API Key (for tenant management & admin access)
# Generate with: node -e "console.log('master_' + require('crypto').randomBytes(32).toString('hex'))"
MASTER_API_KEY=

# Admin Panel Authentication
# Generate password hash with: node -e "import('bcrypt').then(bcrypt => bcrypt.hash('your-password', 10).then(console.log))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Encryption (for credential storage)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Error Tracking (Sentry)
# Get your DSN from https://sentry.io
# If not set, error tracking is disabled
SENTRY_DSN=

# AWS Secrets Manager (optional - for production)
# If AWS_SECRETS_ARN is set, secrets will be loaded from AWS on startup
# and will override the corresponding environment variables above.
# This allows keeping sensitive values out of .env files in production.
#
# The secret should be a JSON object with keys matching env var names:
# {
#   "DATABASE_URL": "...",
#   "OPENAI_API_KEY": "...",
#   "GROQ_API_KEY": "...",
#   "PINECONE_API_KEY": "...",
#   "MASTER_API_KEY": "...",
#   "ADMIN_PASSWORD_HASH": "...",
#   "ENCRYPTION_KEY": "...",
#   "REDIS_URL": "...",
#   "SENTRY_DSN": "..."
# }
AWS_SECRETS_ARN=
AWS_REGION=us-east-1

# CORS Origins (comma-separated, required in production)
# If not set in production, all cross-origin requests will be blocked
CORS_ORIGINS=https://dashboard.example.com,https://admin.example.com
